{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h1>Dierenoverzicht</h1>

        <a href="{{ path('animal_add') }}" class="btn btn-success mb-4">
            Dier toevoegen
        </a>

        <div class="row">
            {% for animal in animals %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="{{ asset(animal.image) }}"
                             class="card-img-top"
                             alt="{{ animal.name }}"
                             style="height: 220px; object-fit: cover;">

                        <div class="card-body">
                            <h5>{{ animal.species }} - {{ animal.name }}</h5>
                            <p>€{{ animal.price|number_format(2, ',', '.') }}</p>

                            <a href="{{ path('animal_detail', {'id': animal.id}) }}"
                               class="btn btn-primary mb-2">
                                Meer info
                            </a>

                            <a href="{{ path('animal_update', {'id': animal.id}) }}"
                               class="btn btn-warning mb-2">
                                Bijwerken
                            </a>

                            <form action="{{ path('animal_delete', {'id': animal.id}) }}"
                                  method="POST"
                                  onsubmit="return confirm('Weet je zeker dat je dit dier wilt verwijderen?');">
                                <button type="submit" class="btn btn-danger">
                                    Verwijderen
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Er zijn nog geen dieren.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
