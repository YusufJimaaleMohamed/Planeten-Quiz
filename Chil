<?php

namespace App\Controller;

use App\Entity\Animal;
use App\Repository\AnimalRepository;
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class AnimalController extends AbstractController
{
    #[Route('/animals', name: 'animal_overview', methods: ['GET'])]
    public function index(AnimalRepository $animalRepository): Response
    {
        return $this->render('animal/index.html.twig', [
            'animals' => $animalRepository->findAll(),
        ]);
    }

    #[Route('/animal/{id}', name: 'animal_detail', methods: ['GET'])]
    public function detail(
        Animal $animal
    ): Response {
        return $this->render('animal/detail.html.twig', [
            'animal' => $animal,
        ]);
    }

    #[Route('/animal/add', name: 'animal_add', methods: ['GET', 'POST'])]
    public function add(
        Request $request,
        EntityManagerInterface $entityManager
    ): Response {
        $animal = new Animal();

        if ($request->isMethod('POST')) {
            $animal->setName($request->request->get('name'));
            $animal->setImage($request->request->get('image'));
            $animal->setPrice((float) $request->request->get('price'));
            $animal->setSpecies($request->request->get('species'));
            $animal->setDescription($request->request->get('description'));

            $entityManager->persist($animal);
            $entityManager->flush();

            return $this->redirectToRoute('animal_overview');
        }

        return $this->render('animal/form.html.twig', [
            'animal' => $animal,
            'title' => 'Dier toevoegen',
        ]);
    }

    #[Route('/animal/update/{id}', name: 'animal_update', methods: ['GET', 'POST'])]
    public function update(
        Animal $animal,
        Request $request,
        EntityManagerInterface $entityManager
    ): Response {
        if ($request->isMethod('POST')) {
            $animal->setName($request->request->get('name'));
            $animal->setImage($request->request->get('image'));
            $animal->setPrice((float) $request->request->get('price'));
            $animal->setSpecies($request->request->get('species'));
            $animal->setDescription($request->request->get('description'));

            $entityManager->flush();

            return $this->redirectToRoute('animal_overview');
        }

        return $this->render('animal/form.html.twig', [
            'animal' => $animal,
            'title' => 'Dier bijwerken',
        ]);
    }

    #[Route('/animal/delete/{id}', name: 'animal_delete', methods: ['POST'])]
    public function delete(
        Animal $animal,
        EntityManagerInterface $entityManager
    ): Response {
        $entityManager->remove($animal);
        $entityManager->flush();

        return $this->redirectToRoute('animal_overview');
    }
}
